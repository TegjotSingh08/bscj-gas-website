# BSCJ Gas & Heating — environment
#
# Copy to .env.local and fill in. Nothing here is NEXT_PUBLIC_: no credential
# and no service-area coordinate may ever reach the browser.

# --- V1: booking, calendar, email (unchanged) ------------------------------

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_REPLY_TO=
BOOKING_NOTIFICATION_EMAIL=

# Optional. Overrides the advertised 12 mile online booking radius.
# SERVICE_AREA_RADIUS_MILES=

# --- V2: database and admin ------------------------------------------------

# Neon Postgres, pooled connection string. This is the one the application
# runtime uses: every request is a short-lived serverless function, where a
# connection pool is something to leak rather than something to reuse.
# Absent is survivable: the public booking flow works without it, and the
# admin area reports the database as not configured rather than crashing.
DATABASE_URL=

# Optional. Neon's direct (unpooled) connection string.
# Used by drizzle-kit for migrations when set, because a migration is one
# long-lived session running DDL rather than a short request, and a transaction
# pooler does not hold session state. Nothing breaks without it — migrations
# fall back to DATABASE_URL, which is what has been used so far.
# DATABASE_URL_UNPOOLED=

# Signs admin session cookies. 32+ random bytes:
#   openssl rand -base64 32
# Rotating this signs everyone out, which is the intended way to revoke access.
AUTH_SECRET=

# --- V2: reserved for later phases ----------------------------------------
# Not read by any code yet. Listed so the deployment checklist is complete.

# Peppers the tenant scheduling token hashes.
#
# Required in production. Without it, tokens are hashed with plain SHA-256 —
# still irreversible, because a token is 32 bytes of CSPRNG output, but a
# database copy alone would then be enough to verify one. With it, verification
# also needs this value.
#
# 32+ random bytes:
#   openssl rand -base64 48
#
# The stored hash names its own algorithm, so adding this later does NOT
# invalidate tokens already sent: existing `sha256$` hashes keep verifying and
# new ones are minted as `hmac$`.
SCHEDULING_TOKEN_SECRET=

# Vercel Blob, private access, for certificates and invoice PDFs (Phase 6).
# BLOB_READ_WRITE_TOKEN=
