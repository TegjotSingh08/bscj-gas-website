{
  "name": "bscj-gas-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --experimental-test-module-mocks --import ./scripts/test-resolver.mjs --test 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "node --experimental-strip-types --import ./scripts/test-resolver.mjs scripts/db-status.mjs",
    "db:studio": "drizzle-kit studio",
    "admin:create": "node --experimental-strip-types --import ./scripts/test-resolver.mjs scripts/create-admin.mjs",
    "preflight": "node --conditions=react-server --experimental-strip-types --import ./scripts/test-resolver.mjs scripts/preflight.mjs",
    "previews": "node --conditions=react-server --experimental-strip-types --import ./scripts/test-resolver.mjs scripts/render-previews.mjs",
    "test:integration": "node --conditions=react-server --experimental-test-module-mocks --import ./scripts/test-resolver.mjs --test-concurrency=1 --test 'test/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
